{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "migrate:up": "bun run src/infrastructure/database/migrate.ts up",
    "migrate:down": "bun run src/infrastructure/database/migrate.ts down",
    "migrate:pending": "bun run src/infrastructure/database/migrate.ts pending",
    "test:unit": "bun test ./src",
    "test:integration": "bun test ./test"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@mikro-orm/core": "6",
    "@mikro-orm/migrations": "6",
    "@mikro-orm/postgresql": "6",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.6",
    "typescript": "^7.0.2"
  }
}
